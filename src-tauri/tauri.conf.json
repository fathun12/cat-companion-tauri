{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cat Companion Tauri Test",
  "version": "0.0.1",
  "identifier": "com.catcompanion.tauritest",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cat Companion",
        "width": 260,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "menu",
        "title": "Menu Kucing",
        "url": "menu/index.html",
        "width": 270,
        "height": 480,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}